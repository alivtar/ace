PORT=
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Instagram webhooks (Meta app)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Encrypts platform access tokens at rest: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# AI providers (each can be swapped in src/ai/index.ts)
# Judgement engine: Jev (TypeSafe). Official endpoint: https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=8000

# Writer (Persian replies, product extraction) and speech-to-text (voice notes): OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_STT_MODEL=gpt-4o-transcribe
